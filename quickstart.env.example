# Copy this file to .env only when you need to override the safe local defaults.
# The built-in database password and auth secret are for loopback-only local use.

# Host ports
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5433

# Browser-visible origins. Keep these aligned with the host ports above.
NEXT_PUBLIC_API_URL=http://localhost:4000
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:3000

# Optional Agent provider. The rest of the application and background jobs start
# without an API key; Agent generation reports AGENT_PROVIDER_NOT_CONFIGURED.
TRAJECTORY_PROVIDER=openai
TRAJECTORY_MODEL=gpt-5-mini
OPENAI_API_KEY=

# DeepSeek alternative:
# TRAJECTORY_PROVIDER=deepseek
# TRAJECTORY_MODEL=deepseek-v4-pro
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
