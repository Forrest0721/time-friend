          "value": "\"items\".\"priority\" IS NULL OR \"items\".\"priority\" IN (0, 1, 3, 5)"
        },
        "items_kind_fields_valid": {
          "name": "items_kind_fields_valid",
          "value": "(\"items\".\"kind\" = 'task' AND \"items\".\"status\" IS NOT NULL) OR (\"items\".\"kind\" = 'note' AND \"items\".\"status\" IS NULL AND \"items\".\"priority\" IS NULL AND \"items\".\"parent_task_id\" IS NULL AND \"items\".\"planned_on\" IS NULL)"
        },
        "items_status_timestamps_valid": {
          "name": "items_status_timestamps_valid",
          "value": "(\"items\".\"status\" = 'completed' AND \"items\".\"completed_at\" IS NOT NULL AND \"items\".\"abandoned_at\" IS NULL)\n        OR (\"items\".\"status\" = 'abandoned' AND \"items\".\"abandoned_at\" IS NOT NULL AND \"items\".\"completed_at\" IS NULL)\n        OR (\"items\".\"status\" = 'pending' AND \"items\".\"completed_at\" IS NULL AND \"items\".\"abandoned_at\" IS NULL)\n        OR (\"items\".\"status\" IS NULL AND \"items\".\"completed_at\" IS NULL AND \"items\".\"abandoned_at\" IS NULL)"
        }
      },
