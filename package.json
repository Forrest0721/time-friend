{
  "name": "time-friend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --parallel run build",
    "site:build": "vite build",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "pnpm -r --parallel run test",
    "test:e2e": "playwright test",
    "lint": "eslint apps packages tests playwright.config.ts --ext .ts,.tsx",
    "typecheck": "pnpm -r --parallel run typecheck && tsc --project tests/e2e/tsconfig.json",
    "db:generate": "pnpm --filter @time-friend/db run generate",
    "db:migrate": "pnpm --filter @time-friend/db run migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "clean": "pnpm -r exec rm -rf .turbo dist .next && rm -rf node_modules"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.55.1",
    "@types/node": "22.19.19",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "prettier": "3.5.3",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
